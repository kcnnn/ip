# Copy outside the public web root; chmod 600. Never commit the populated file.
JEV_WORKER_TOKEN=replace-with-a-random-32-or-more-character-service-secret
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
JEV_CHROME_PATH=/usr/bin/google-chrome-stable
JEV_MANUFACTURERS_FILE=/etc/apex/manufacturers.json
JEV_WORKER_PORT=8787
